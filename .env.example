# --- TTS provider selection ---------------------------------------------
# Which provider the server uses by default. Currently only ElevenLabs
# is registered; WebSpeech (browser-side) is always available as a
# fallback regardless of this setting.
#   elevenlabs   free tier, no credit card (recommended)
#   webspeech    Browser-side only; proxy returns a JSON directive
# Override at runtime via window.LC_TTS_PROVIDERS.setActive('<id>')
TTS_PROVIDER=elevenlabs

# --- ElevenLabs ---------------------------------------------------------
# Sign up at https://elevenlabs.io → Profile → API Key
# Free tier: 10k chars/month, no credit card required.
ELEVENLABS_API_KEY=
# Default voice. Defaults to Callum (deep male, multilingual) if unset.
# Find IDs at https://api.elevenlabs.io/v1/voices
# Other deep male picks:
#   b0e9dk46J60vl9FwM1sF  Callum (deep, mature)
#   TxGEqnHWrfWFTfGWdXjX  Clyde (deep, gruff)
#   onwK4e9ZLuTAKqWW03F9  Daniel (neutral, multilingual)
ELEVENLABS_VOICE_ID=b0e9dk46J60vl9FwM1sF

# --- Server -------------------------------------------------------------
# The Node server now serves BOTH the static frontend and the TTS API on
# the same origin, so you only need ONE port open (no separate python
# http.server). Defaults to http://localhost:3000.
# Open that URL in your browser — /api/tts, /health, /api/providers,
# index.html, styles.css, Turkish/*.html, and lessons-data/*.js all
# resolve from the same origin.
PORT=3000

# --- Learning speed -----------------------------------------------------
# Default TTS speed multiplier for new learners. 1.0 = normal, 0.8 = a
# bit slower (recommended for beginners). Frontend can override at
# runtime via window.LC_TTS_SPEED = 0.7 in DevTools, or via the Speed
# slider in the toolbar. Range 0.5–1.0; values > 1.0 are not recommended
# for language learning because stretched speech sounds unnatural.
TTS_DEFAULT_SPEED=0.8

# --- Cache --------------------------------------------------------------
# On-disk TTS cache root. Defaults to <repo>/.cache (outside the source
# tree so it doesn't ship with deployments). Override with an absolute
# path to put it elsewhere (e.g. on a different volume). Shared across
# users — when user A synthesizes a Turkish sentence, user B's identical
# request reuses the same audio bytes (no upstream call).
# Default cap = 200 MB; oldest entries are evicted by atime when the cap
# is exceeded. Set to 0 to disable.
TTS_CACHE_ROOT=
TTS_CACHE_MAX_BYTES=209715200